//! # AST Parser
//!
//! Tree-sitter-based source code parser. Extracts symbols (functions, classes,
//! methods, routes) and relationships (calls, imports) from source files.
//!
//! Language dispatch happens here — one function per language grammar.

use anyhow::{anyhow, Result};
use std::path::Path;
use tree_sitter::{Parser, Query, QueryCursor};

// ── Re-exported types ──────────────────────────────────────────────

/// A symbol extracted from source code.
#[derive(Debug, Clone)]
pub struct Symbol {
    pub id: String,            // "src/main.rs::calculate_total"
    pub name: String,          // "calculate_total"
    pub kind: SymbolKind,      // Function, Class, Method, Struct, Route
    pub file_path: String,     // relative, e.g. "src/main.rs"
    pub line_start: usize,
    pub line_end: usize,
    pub signature: String,     // e.g. "fn calculate_total(items: &[Item]) -> f64"
    pub docstring: Option<String>,
    pub properties: serde_json::Value,  // extra: {route, method, decorators, ...}
}

/// The kind of a symbol.
#[derive(Debug, Clone, PartialEq)]
pub enum SymbolKind {
    Function,
    Class,
    Method,
    Struct,     // Rust
    Interface,  // TypeScript
    Enum,
    Route,      // HTTP handler
}

impl SymbolKind {
    pub fn as_str(&self) -> &'static str {
        match self {
            SymbolKind::Function => "function",
            SymbolKind::Class => "class",
            SymbolKind::Method => "method",
            SymbolKind::Struct => "struct",
            SymbolKind::Interface => "interface",
            SymbolKind::Enum => "enum",
            SymbolKind::Route => "route",
        }
    }
}

/// A directed edge between two symbols.
#[derive(Debug, Clone)]
pub struct Edge {
    pub source: String,   // symbol id of caller/importer
    pub target: String,   // symbol id of callee/importee
    pub kind: EdgeKind,
}

#[derive(Debug, Clone)]
pub enum EdgeKind {
    Calls,
    Imports,
    Inherits,
    Defines,   // class → method
}

impl EdgeKind {
    pub fn as_str(&self) -> &'static str {
        match self {
            EdgeKind::Calls => "calls",
            EdgeKind::Imports => "imports",
            EdgeKind::Inherits => "inherits",
            EdgeKind::Defines => "defines",
        }
    }
}

// ── Parser dispatch ────────────────────────────────────────────────

/// Parse a single source file, returning (symbols, edges).
pub fn parse_file(
    relative_path: &Path,
    source: &str,
    _full_path: &Path,    // reserved for future use (e.g. resolve imports)
) -> Result<(Vec<Symbol>, Vec<Edge>)> {
    let ext = relative_path
        .extension()
        .and_then(|e| e.to_str())
        .ok_or_else(|| anyhow!("no file extension"))?;

    match ext {
        "py" => parse_python(relative_path, source),
        "ts" | "tsx" | "js" | "jsx" => parse_typescript(relative_path, source, ext),
        "rs" => parse_rust(relative_path, source),
        "go" => parse_go(relative_path, source),
        _ => Err(anyhow!("unsupported extension: {}", ext)),
    }
}

// ── Python parser ──────────────────────────────────────────────────

fn parse_python(relative_path: &Path, source: &str) -> Result<(Vec<Symbol>, Vec<Edge>)> {
    let mut parser = Parser::new();
    parser.set_language(tree_sitter_python::LANGUAGE.into()?;
    let tree = parser.parse(source, None)
        .ok_or_else(|| anyhow!("parse failed"))?;

    let mut symbols = Vec::new();
    let mut edges = Vec::new();
    let bytes = source.as_bytes();
    let path_str = relative_path.to_string_lossy().to_string();

    // Extract function definitions
    let func_query = Query::new(
        tree_sitter_python::language(),
        r#"
        (function_definition
            name: (identifier) @name
            parameters: (parameters) @params
            body: (block) @body) @func
        "#
    )?;

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&func_query, tree.root_node(), bytes) {
        let capture = |name: &str| m.captures.iter().find(|c| c.0 == name).map(|c| c.1);

        if let (Some(func_node), Some(name_node), Some(params_node), Some(body_node)) =
           (capture("func"), capture("name"), capture("params"), capture("body"))
        {
            let name = name_node.utf8_text(bytes)?.to_string();
            let id = format!("{}::{}", path_str, name);
            let sig = extract_node_text(params_node, bytes);

            symbols.push(Symbol {
                id: id.clone(),
                name,
                kind: SymbolKind::Function,
                file_path: path_str.clone(),
                line_start: func_node.start_position().row + 1,
                line_end: func_node.end_position().row + 1,
                signature: format!("def {}({})", name_node.utf8_text(bytes)?, sig),
                docstring: extract_docstring(body_node, bytes),
                properties: serde_json::Value::Null,
            });

            // Extract calls within this function body
            extract_python_calls(body_node, &id, bytes, &mut edges);
        }
    }

    // Extract class definitions
    let class_query = Query::new(
        tree_sitter_python::language(),
        r#"
        (class_definition
            name: (identifier) @name
            body: (block) @body) @class
        "#
    )?;

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&class_query, tree.root_node(), bytes) {
        let capture = |name: &str| m.captures.iter().find(|c| c.0 == name).map(|c| c.1);

        if let (Some(class_node), Some(name_node), Some(body_node)) =
           (capture("class"), capture("name"), capture("body"))
        {
            let name = name_node.utf8_text(bytes)?.to_string();
            let id = format!("{}::{}", path_str, name);

            symbols.push(Symbol {
                id: id.clone(),
                name: name.clone(),
                kind: SymbolKind::Class,
                file_path: path_str.clone(),
                line_start: class_node.start_position().row + 1,
                line_end: class_node.end_position().row + 1,
                signature: format!("class {}", name),
                docstring: extract_docstring(body_node, bytes),
                properties: serde_json::Value::Null,
            });

            // Extract methods within this class
            extract_class_methods(body_node, &id, &path_str, bytes, &mut symbols, &mut edges);
        }
    }

    // Extract imports
    extract_python_imports(tree.root_node(), &path_str, bytes, &mut edges);

    Ok((symbols, edges))
}

fn extract_python_calls(node: tree_sitter::Node, caller_id: &str, bytes: &[u8], edges: &mut Vec<Edge>) {
    let query = Query::new(
        tree_sitter_python::language(),
        "(call function: (identifier) @called)"
    ).unwrap();

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&query, node, bytes) {
        let name = m.captures[0].1.utf8_text(bytes).unwrap();
        // We don't resolve target_id here — graph builder does that
        edges.push(Edge {
            source: caller_id.to_string(),
            target: name.to_string(),  // will be resolved later
            kind: EdgeKind::Calls,
        });
    }
}

fn extract_class_methods(
    class_body: tree_sitter::Node,
    class_id: &str,
    path_str: &str,
    bytes: &[u8],
    symbols: &mut Vec<Symbol>,
    edges: &mut Vec<Edge>,
) {
    // Reuse the function body query but constrained to this class
    let query = Query::new(
        tree_sitter_python::language(),
        r#"
        (function_definition
            name: (identifier) @name
            parameters: (parameters) @params
            body: (block) @body) @func
        "#
    ).unwrap();

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&query, class_body, bytes) {
        let capture = |name: &str| m.captures.iter().find(|c| c.0 == name).map(|c| c.1);

        if let (Some(func_node), Some(name_node), Some(params_node), Some(body_node)) =
           (capture("func"), capture("name"), capture("params"), capture("body"))
        {
            let name = name_node.utf8_text(bytes).unwrap().to_string();
            let method_id = format!("{}::{}", path_str, name);
            let sig = extract_node_text(params_node, bytes);

            symbols.push(Symbol {
                id: method_id.clone(),
                name,
                kind: SymbolKind::Method,
                file_path: path_str.to_string(),
                line_start: func_node.start_position().row + 1,
                line_end: func_node.end_position().row + 1,
                signature: format!("def {}({})", name_node.utf8_text(bytes).unwrap(), sig),
                docstring: extract_docstring(body_node, bytes),
                properties: serde_json::Value::Null,
            });

            // Edge: class DEFINES method
            edges.push(Edge {
                source: class_id.to_string(),
                target: method_id.clone(),
                kind: EdgeKind::Defines,
            });

            // Calls within method
            extract_python_calls(body_node, &method_id, bytes, edges);
        }
    }
}

fn extract_python_imports(root: tree_sitter::Node, path_str: &str, bytes: &[u8], edges: &mut Vec<Edge>) {
    // import_statement: `import foo, bar`
    let query = Query::new(
        tree_sitter_python::language(),
        r#"
        (import_statement
            name: (dotted_name) @module)
        (import_from_statement
            module_name: (dotted_name) @source
            name: (dotted_name) @imported)
        "#
    ).unwrap();

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&query, root, bytes) {
        // 'module' captures: plain imports
        if let Some(cap) = m.captures.iter().find(|c| c.0 == "module") {
            let module = cap.1.utf8_text(bytes).unwrap();
            edges.push(Edge {
                source: path_str.to_string(),
                target: module.to_string(),
                kind: EdgeKind::Imports,
            });
        }
        // 'imported' captures: from X import Y
        if let Some(cap) = m.captures.iter().find(|c| c.0 == "imported") {
            let imported = cap.1.utf8_text(bytes).unwrap();
            edges.push(Edge {
                source: path_str.to_string(),
                target: imported.to_string(),
                kind: EdgeKind::Imports,
            });
        }
    }
}

// ── TypeScript / JavaScript parser ─────────────────────────────────

fn parse_typescript(relative_path: &Path, source: &str, _ext: &str) -> Result<(Vec<Symbol>, Vec<Edge>)> {
    let mut parser = Parser::new();
    parser.set_language(tree_sitter_typescript::language_typescript())?;
    let tree = parser.parse(source, None)
        .ok_or_else(|| anyhow!("parse failed"))?;

    let mut symbols = Vec::new();
    let mut edges = Vec::new();
    let bytes = source.as_bytes();
    let path_str = relative_path.to_string_lossy().to_string();

    // Function declarations
    let func_query = Query::new(
        tree_sitter_typescript::language_typescript(),
        r#"
        (function_declaration
            name: (identifier) @name
            parameters: (formal_parameters) @params
            body: (statement_block) @body) @func
        
        (arrow_function) @arrow
        "#
    )?;

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&func_query, tree.root_node(), bytes) {
        if let (Some(func_node), Some(name_node)) = (
            m.captures.iter().find(|c| c.0 == "func"),
            m.captures.iter().find(|c| c.0 == "name"),
        ) {
            let (fn_node, nm_node) = (func_node.1, name_node.1);
            let name = nm_node.utf8_text(bytes)?.to_string();
            let id = format!("{}::{}", path_str, name);

            let sig_params = m.captures.iter()
                .find(|c| c.0 == "params")
                .map(|c| extract_node_text(c.1, bytes))
                .unwrap_or_default();

            symbols.push(Symbol {
                id: id.clone(),
                name,
                kind: SymbolKind::Function,
                file_path: path_str.clone(),
                line_start: fn_node.start_position().row + 1,
                line_end: fn_node.end_position().row + 1,
                signature: format!("function {}({})", nm_node.utf8_text(bytes)?, sig_params),
                docstring: None,
                properties: serde_json::Value::Null,
            });

            // Call graph
            if let Some(body_node) = m.captures.iter().find(|c| c.0 == "body") {
                extract_ts_calls(body_node.1, &id, bytes, &mut edges);
            }
        }
    }

    // Class declarations
    let class_query = Query::new(
        tree_sitter_typescript::language_typescript(),
        r#"
        (class_declaration
            name: (identifier) @name
            body: (class_body) @body) @class
        "#
    )?;

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&class_query, tree.root_node(), bytes) {
        let capture = |name: &str| m.captures.iter().find(|c| c.0 == name).map(|c| c.1);
        if let (Some(class_node), Some(name_node), Some(body_node)) =
           (capture("class"), capture("name"), capture("body"))
        {
            let name = name_node.utf8_text(bytes)?.to_string();
            let id = format!("{}::{}", path_str, name);

            symbols.push(Symbol {
                id: id.clone(),
                name: name.clone(),
                kind: SymbolKind::Class,
                file_path: path_str.clone(),
                line_start: class_node.start_position().row + 1,
                line_end: class_node.end_position().row + 1,
                signature: format!("class {}", name),
                docstring: None,
                properties: serde_json::Value::Null,
            });

            // Extract methods
            extract_ts_methods(body_node, &id, &path_str, bytes, &mut symbols, &mut edges);
        }
    }

    // Imports
    extract_ts_imports(tree.root_node(), &path_str, bytes, &mut edges);

    Ok((symbols, edges))
}

fn extract_ts_calls(node: tree_sitter::Node, caller_id: &str, bytes: &[u8], edges: &mut Vec<Edge>) {
    let query = Query::new(
        tree_sitter_typescript::language_typescript(),
        "(call_expression function: (identifier) @called)"
    ).unwrap();

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&query, node, bytes) {
        let name = m.captures[0].1.utf8_text(bytes).unwrap();
        edges.push(Edge {
            source: caller_id.to_string(),
            target: name.to_string(),
            kind: EdgeKind::Calls,
        });
    }
}

fn extract_ts_methods(
    class_body: tree_sitter::Node,
    class_id: &str,
    path_str: &str,
    bytes: &[u8],
    symbols: &mut Vec<Symbol>,
    edges: &mut Vec<Edge>,
) {
    let query = Query::new(
        tree_sitter_typescript::language_typescript(),
        r#"
        (method_definition
            name: (property_identifier) @name
            parameters: (formal_parameters) @params
            body: (statement_block) @body) @method
        "#
    ).unwrap();

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&query, class_body, bytes) {
        let capture = |name: &str| m.captures.iter().find(|c| c.0 == name).map(|c| c.1);
        if let (Some(method_node), Some(name_node)) = (capture("method"), capture("name")) {
            let name = name_node.utf8_text(bytes).unwrap().to_string();
            let method_id = format!("{}::{}", path_str, name);
            let sig_params = capture("params")
                .map(|n| extract_node_text(n, bytes))
                .unwrap_or_default();

            symbols.push(Symbol {
                id: method_id.clone(),
                name,
                kind: SymbolKind::Method,
                file_path: path_str.to_string(),
                line_start: method_node.start_position().row + 1,
                line_end: method_node.end_position().row + 1,
                signature: format!("{}({})", name_node.utf8_text(bytes).unwrap(), sig_params),
                docstring: None,
                properties: serde_json::Value::Null,
            });

            edges.push(Edge {
                source: class_id.to_string(),
                target: method_id.clone(),
                kind: EdgeKind::Defines,
            });

            if let Some(body_node) = capture("body") {
                extract_ts_calls(body_node, &method_id, bytes, edges);
            }
        }
    }
}

fn extract_ts_imports(root: tree_sitter::Node, path_str: &str, bytes: &[u8], edges: &mut Vec<Edge>) {
    let query = Query::new(
        tree_sitter_typescript::language_typescript(),
        r#"
        (import_statement
            source: (string) @source) @import
        "#
    ).unwrap();

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&query, root, bytes) {
        if let Some(source_cap) = m.captures.iter().find(|c| c.0 == "source") {
            let source_text = source_cap.1.utf8_text(bytes).unwrap();
            edges.push(Edge {
                source: path_str.to_string(),
                target: source_text.trim_matches(&['"', '\''] as &[char]).to_string(),
                kind: EdgeKind::Imports,
            });
        }
    }
}

// ── Rust parser ────────────────────────────────────────────────────

fn parse_rust(relative_path: &Path, source: &str) -> Result<(Vec<Symbol>, Vec<Edge>)> {
    let mut parser = Parser::new();
    parser.set_language(tree_sitter_rust::language())?;
    let tree = parser.parse(source, None)
        .ok_or_else(|| anyhow!("parse failed"))?;

    let mut symbols = Vec::new();
    let mut edges = Vec::new();
    let bytes = source.as_bytes();
    let path_str = relative_path.to_string_lossy().to_string();

    // Functions
    let func_query = Query::new(
        tree_sitter_rust::language(),
        r#"
        (function_item
            name: (identifier) @name
            parameters: (parameters) @params
            body: (block) @body) @func
        "#
    )?;

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&func_query, tree.root_node(), bytes) {
        let capture = |name: &str| m.captures.iter().find(|c| c.0 == name).map(|c| c.1);

        if let (Some(func_node), Some(name_node), Some(params_node), Some(body_node)) =
           (capture("func"), capture("name"), capture("params"), capture("body"))
        {
            let name = name_node.utf8_text(bytes)?.to_string();
            let id = format!("{}::{}", path_str, name);
            let sig = extract_node_text(params_node, bytes);

            symbols.push(Symbol {
                id: id.clone(),
                name,
                kind: SymbolKind::Function,
                file_path: path_str.clone(),
                line_start: func_node.start_position().row + 1,
                line_end: func_node.end_position().row + 1,
                signature: format!("fn {}({})", name_node.utf8_text(bytes)?, sig),
                docstring: None,
                properties: serde_json::Value::Null,
            });

            extract_rust_calls(body_node, &id, bytes, &mut edges);
        }
    }

    // Structs
    let struct_query = Query::new(
        tree_sitter_rust::language(),
        r#"
        (struct_item
            name: (type_identifier) @name) @struct
        "#
    )?;

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&struct_query, tree.root_node(), bytes) {
        if let (Some(s), Some(n)) = (
            m.captures.iter().find(|c| c.0 == "struct"),
            m.captures.iter().find(|c| c.0 == "name"),
        ) {
            let name = n.1.utf8_text(bytes)?.to_string();
            symbols.push(Symbol {
                id: format!("{}::{}", path_str, name),
                name,
                kind: SymbolKind::Struct,
                file_path: path_str.clone(),
                line_start: s.1.start_position().row + 1,
                line_end: s.1.end_position().row + 1,
                signature: format!("struct {}", n.1.utf8_text(bytes)?),
                docstring: None,
                properties: serde_json::Value::Null,
            });
        }
    }

    Ok((symbols, edges))
}

fn extract_rust_calls(node: tree_sitter::Node, caller_id: &str, bytes: &[u8], edges: &mut Vec<Edge>) {
    let query = Query::new(
        tree_sitter_rust::language(),
        "(call_expression function: (identifier) @called)"
    ).unwrap();

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&query, node, bytes) {
        let name = m.captures[0].1.utf8_text(bytes).unwrap();
        edges.push(Edge {
            source: caller_id.to_string(),
            target: name.to_string(),
            kind: EdgeKind::Calls,
        });
    }
}

// ── Go parser ──────────────────────────────────────────────────────

fn parse_go(relative_path: &Path, source: &str) -> Result<(Vec<Symbol>, Vec<Edge>)> {
    let mut parser = Parser::new();
    parser.set_language(tree_sitter_go::language())?;
    let tree = parser.parse(source, None)
        .ok_or_else(|| anyhow!("parse failed"))?;

    let mut symbols = Vec::new();
    let mut edges = Vec::new();
    let bytes = source.as_bytes();
    let path_str = relative_path.to_string_lossy().to_string();

    // Function declarations: `func foo() { ... }`
    let func_query = Query::new(
        tree_sitter_go::language(),
        r#"
        (function_declaration
            name: (identifier) @name
            parameters: (parameter_list) @params
            body: (block) @body) @func
        "#
    )?;

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&func_query, tree.root_node(), bytes) {
        let capture = |name: &str| m.captures.iter().find(|c| c.0 == name).map(|c| c.1);

        if let (Some(func_node), Some(name_node), Some(params_node), Some(body_node)) =
           (capture("func"), capture("name"), capture("params"), capture("body"))
        {
            let name = name_node.utf8_text(bytes)?.to_string();
            let id = format!("{}::{}", path_str, name);
            let sig = extract_node_text(params_node, bytes);

            symbols.push(Symbol {
                id: id.clone(),
                name,
                kind: SymbolKind::Function,
                file_path: path_str.clone(),
                line_start: func_node.start_position().row + 1,
                line_end: func_node.end_position().row + 1,
                signature: format!("func {}({})", name_node.utf8_text(bytes)?, sig),
                docstring: None,
                properties: serde_json::Value::Null,
            });

            extract_go_calls(body_node, &id, bytes, &mut edges);
        }
    }

    // Method declarations: `func (r *Receiver) Method() { ... }`
    let method_query = Query::new(
        tree_sitter_go::language(),
        r#"
        (method_declaration
            name: (field_identifier) @name
            parameters: (parameter_list) @params
            body: (block) @body) @method
        "#
    )?;

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&method_query, tree.root_node(), bytes) {
        let capture = |name: &str| m.captures.iter().find(|c| c.0 == name).map(|c| c.1);

        if let (Some(method_node), Some(name_node), Some(params_node), Some(body_node)) =
           (capture("method"), capture("name"), capture("params"), capture("body"))
        {
            let name = name_node.utf8_text(bytes)?.to_string();
            let id = format!("{}::{}", path_str, name);
            let sig = extract_node_text(params_node, bytes);

            symbols.push(Symbol {
                id: id.clone(),
                name,
                kind: SymbolKind::Method,
                file_path: path_str.clone(),
                line_start: method_node.start_position().row + 1,
                line_end: method_node.end_position().row + 1,
                signature: format!("func (r) {}({})", name_node.utf8_text(bytes)?, sig),
                docstring: None,
                properties: serde_json::Value::Null,
            });

            extract_go_calls(body_node, &id, bytes, &mut edges);
        }
    }

    // Struct types: `type Foo struct { ... }`
    let struct_query = Query::new(
        tree_sitter_go::language(),
        r#"
        (type_declaration
            (type_spec
                name: (type_identifier) @name
                type: (struct_type) @body)) @struct
        "#
    )?;

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&struct_query, tree.root_node(), bytes) {
        let capture = |name: &str| m.captures.iter().find(|c| c.0 == name).map(|c| c.1);

        if let (Some(struct_node), Some(name_node)) = (capture("struct"), capture("name")) {
            let name = name_node.utf8_text(bytes)?.to_string();
            symbols.push(Symbol {
                id: format!("{}::{}", path_str, name),
                name: name.clone(),
                kind: SymbolKind::Struct,
                file_path: path_str.clone(),
                line_start: struct_node.start_position().row + 1,
                line_end: struct_node.end_position().row + 1,
                signature: format!("type {} struct{{...}}", name),
                docstring: None,
                properties: serde_json::Value::Null,
            });

            // Extract methods defined on this struct (same file, later)
            // Note: Go methods can be defined separately from structs
            extract_go_struct_methods(body_node, &path_str, bytes, &mut symbols, &mut edges);
        }
    }

    // Interfaces
    let iface_query = Query::new(
        tree_sitter_go::language(),
        r#"
        (type_declaration
            (type_spec
                name: (type_identifier) @name
                type: (interface_type) @body)) @iface
        "#
    )?;

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&iface_query, tree.root_node(), bytes) {
        if let Some(cap) = m.captures.iter().find(|c| c.0 == "name") {
            let name = cap.1.utf8_text(bytes)?.to_string();
            symbols.push(Symbol {
                id: format!("{}::{}", path_str, name),
                name,
                kind: SymbolKind::Interface,
                file_path: path_str.clone(),
                line_start: cap.1.start_position().row + 1,
                line_end: cap.1.end_position().row + 1,
                signature: format!("type {} interface{{...}}", cap.1.utf8_text(bytes)?),
                docstring: None,
                properties: serde_json::Value::Null,
            });
        }
    }

    // Imports
    extract_go_imports(tree.root_node(), &path_str, bytes, &mut edges);

    Ok((symbols, edges))
}

fn extract_go_calls(node: tree_sitter::Node, caller_id: &str, bytes: &[u8], edges: &mut Vec<Edge>) {
    let query = Query::new(
        tree_sitter_go::language(),
        "(call_expression function: (identifier) @called)"
    ).unwrap();

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&query, node, bytes) {
        let name = m.captures[0].1.utf8_text(bytes).unwrap();
        edges.push(Edge {
            source: caller_id.to_string(),
            target: name.to_string(),
            kind: EdgeKind::Calls,
        });
    }
}

fn extract_go_struct_methods(
    _struct_body: tree_sitter::Node,
    _path_str: &str,
    _bytes: &[u8],
    _symbols: &mut Vec<Symbol>,
    _edges: &mut Vec<Edge>,
) {
    // Go methods are defined as top-level `func (r Receiver) method()` — not inside struct bodies.
    // They're already captured by the method_declaration query above.
    // This function is a placeholder for future receiver-type → method edges.
}

fn extract_go_imports(root: tree_sitter::Node, path_str: &str, bytes: &[u8], edges: &mut Vec<Edge>) {
    let query = Query::new(
        tree_sitter_go::language(),
        r#"
        (import_declaration
            (import_spec
                path: (interpreted_string_literal) @path))
        "#
    ).unwrap();

    let mut cursor = QueryCursor::new();
    for m in cursor.matches(&query, root, bytes) {
        if let Some(cap) = m.captures.iter().find(|c| c.0 == "path") {
            let pkg = cap.1.utf8_text(bytes).unwrap();
            edges.push(Edge {
                source: path_str.to_string(),
                target: pkg.trim_matches('"').to_string(),
                kind: EdgeKind::Imports,
            });
        }
    }
}

// ── Helpers ────────────────────────────────────────────────────────

fn extract_node_text(node: tree_sitter::Node, bytes: &[u8]) -> String {
    node.utf8_text(bytes).unwrap_or("").to_string()
}

fn extract_docstring(body_node: tree_sitter::Node, bytes: &[u8]) -> Option<String> {
    // Look for the first string expression in the body
    let mut cursor = body_node.walk();
    for child in body_node.children(&mut cursor) {
        if child.kind() == "expression_statement" {
            if let Some(inner) = child.child(0) {
                if inner.kind() == "string" {
                    return Some(inner.utf8_text(bytes).unwrap_or("").to_string());
                }
            }
        }
    }
    None
}
